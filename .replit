modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "typecheck"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "migrations"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "google-sso"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "test"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "raci-conflict"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "staff-access"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "issues-legacy-date"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "issue-open-age"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "stale-threshold"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "theme-os"

[[workflows.workflow]]
name = "typecheck"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npx tsc -b lib/db lib/api-zod && pnpm --filter @workspace/api-server typecheck"

[[workflows.workflow]]
name = "migrations"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts verify-migrations"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "google-sso"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run google-sso-ui-check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "test"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/api-server test && pnpm --filter @workspace/sage-oak-dashboard test"

[[workflows.workflow]]
name = "raci-conflict"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run raci-conflict-ui-check && pnpm --filter @workspace/scripts run raci-highlight-fade-check"

[[workflows.workflow]]
name = "staff-access"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run staff-access-check && pnpm --filter @workspace/scripts run staff-ui-check && pnpm --filter @workspace/scripts run issues-new-marker-check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "issues-legacy-date"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run issues-legacy-date-check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "issue-open-age"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run issue-open-age-check"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "stale-threshold"
author = "agent"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run stale-threshold-ui-check && pnpm --filter @workspace/scripts run stale-threshold-invalid-ui-check"

[[workflows.workflow]]
name = "theme-os"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/scripts run theme-os-preference-check"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
